{
  "name": "go-phones-pos",
  "version": "0.1.0-foundation",
  "description": "Go Phones POS V1 — Phase 1 application foundation scaffold. Local-first Windows Electron + React + TypeScript + better-sqlite3. See docs/ for the canonical specification. No POS business functionality is implemented yet.",
  "private": true,
  "type": "commonjs",
  "main": "./out/main/index.js",
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SalAkBuK/go-alvin-pos.git"
  },
  "bugs": {
    "url": "https://github.com/SalAkBuK/go-alvin-pos/issues"
  },
  "homepage": "https://github.com/SalAkBuK/go-alvin-pos#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "pack:win": "npm run build && electron-builder --win --dir && npm run verify:packaging",
    "dist:win": "npm run build && electron-builder --win && npm run verify:packaging"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.gophones.pos",
    "productName": "Go Phones POS",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "dir"
    },
    "directories": {
      "output": "release"
    }
  }
}
